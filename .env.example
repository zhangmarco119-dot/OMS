# v2-development 使用 development；manage-system 使用 production。
VITE_APP_ENV=development
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# 两项都是非密钥的 20 位 Supabase Project Ref，用于阻止分支连错数据库。
STOREHUB_PRODUCTION_SUPABASE_REF=your-production-ref
STOREHUB_DEVELOPMENT_SUPABASE_REF=your-development-ref

VITE_ENABLE_V2_ARRIVAL_ENTRY=true
VITE_ENABLE_V2_TASK_TEMPLATES=true
