{
  "name": "mobile-store-inventory-ordering",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "scripts": {
    "env:check": "node scripts/verify-environment.mjs",
    "migrations:check": "node scripts/check-migration-safety.mjs",
    "migrations:remote:check": "node scripts/verify-remote-migrations.mjs",
    "manuals:sync": "node scripts/sync-system-documents.mjs",
    "release:version:check": "node scripts/check-release-version.mjs",
    "release:check": "node scripts/release-gate.mjs",
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "validate:supabase": "node scripts/validate-supabase-schema.mjs",
    "audit:security": "node scripts/security-check.mjs",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build && node scripts/verify-build-environment.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "@supabase/supabase-js": "^2.51.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.2",
    "react-router-dom": "^6.26.2",
    "tailwind-merge": "^2.5.2",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "jsdom": "^25.0.0",
    "playwright": "1.61.1",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.1.0",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
